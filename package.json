{
  "name": "azure-devops-local-mcp",
  "version": "0.2.0",
  "description": "MCP server for Azure DevOps — connect Claude to work items, repos, pipelines, and more",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "azure-devops-local-mcp": "dist/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "start:sse": "node dist/index.js --transport http",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:int": "vitest run tests/integration",
    "test:watch": "vitest",
    "lint": "eslint src/ tests/ && prettier --check src/ tests/",
    "lint:fix": "eslint --fix src/ tests/ && prettier --write src/ tests/"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.21.0",
    "express": "^4.21.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Laonnda/azure-devops-local-mcp.git"
  },
  "keywords": [
    "mcp",
    "azure-devops",
    "claude",
    "ai"
  ],
  "homepage": "https://github.com/Laonnda/azure-devops-local-mcp",
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "overrides": {
    "qs": "^6.16.0"
  }
}
