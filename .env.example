# Azure DevOps MCP Server Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to the repository

# ---------------------------------------------------------------------------
# Required: Your Azure DevOps organization URL
# ---------------------------------------------------------------------------
ADO_ORG_URL=https://dev.azure.com/yourorg

# ---------------------------------------------------------------------------
# Authentication — set EXACTLY ONE of the three methods below
# ---------------------------------------------------------------------------

# Method 1: Personal Access Token (simplest, recommended for local dev)
# Create at: https://dev.azure.com/{org}/_usersSettings/tokens
# Minimum scopes depend on which tools you use -- see CLAUDE.md
ADO_PAT=

# Method 2: OAuth 2.0 (user delegation; requires an Azure AD app registration)
# Register an app at https://portal.azure.com and grant Azure DevOps
# user_impersonation permission. After authorization, set ADO_AUTH_CODE to the
# code returned by the redirect URI and restart the server.
ADO_CLIENT_ID=
ADO_CLIENT_SECRET=
ADO_TENANT_ID=
# Authorization code from the OAuth consent flow (one-time use)
ADO_AUTH_CODE=
# Redirect URI registered on the Azure AD app (default: http://localhost/callback)
ADO_OAUTH_REDIRECT_URI=

# Method 3: Azure Managed Identity (Azure-hosted environments only)
# Enable a system-assigned or user-assigned identity on the Azure resource.
# Set to "true" to use Managed Identity authentication.
ADO_USE_MANAGED_IDENTITY=
# Optional: client ID for user-assigned identities (leave blank for system-assigned)
ADO_MI_CLIENT_ID=

# ---------------------------------------------------------------------------
# Optional settings
# ---------------------------------------------------------------------------

# Default project for operations (can be overridden per tool call)
ADO_DEFAULT_PROJECT=

# Log level (debug, info, warn, error) — default: info
ADO_LOG_LEVEL=info
